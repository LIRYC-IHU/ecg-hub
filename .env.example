# ECG Hub — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.

# --- PostgreSQL ---
DB_USER=ecghub_user
DB_PASSWORD=admin
DATABASE_URL=postgres://ecghub_user:admin@ecghub:5432/ecghub?sslmode=disable

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret

# --- Secrets-at-rest encryption (AUTH_ENCRYPTION_KEY) ---
# AES-256-GCM key encrypting all provider/connector secrets stored in the DB
# (OIDC/LDAP secrets, FTP/HL7/connector credentials).
# REQUIRED in production: min 32 chars, unique, never the dev default.
# Generate with: openssl rand -base64 48
# In production (APP_ENV=production or server.tls=true) the server refuses to
# start if this is empty, too short, or the public dev default.
AUTH_ENCRYPTION_KEY=replace-with-a-32+-char-random-key

# --- Runtime mode ---
# Set to "production" to enable fail-fast security checks (encryption key, etc.).
APP_ENV=development


# --- OIDC (when auth.provider: oidc) ---
OIDC_CLIENT_ID=ecg-hub
OIDC_CLIENT_SECRET=replace-with-oidc-secret
# OIDC_ADMIN_CLIENT_SECRET — client secret for the Keycloak Admin API (client_credentials grant).
# Required only if user/role management via the admin endpoints is used. Leave empty to disable.
OIDC_ADMIN_CLIENT_SECRET=

# --- LDAP (when auth.provider: ldap) ---
LDAP_BIND_DN=cn=ecghub,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-with-ldap-password

# --- FTP server credentials ---
FTP_USERNAME=ecgdevice
FTP_PASSWORD=replace-with-ftp-password

# --- HL7 client credentials ---
HL7_USERNAME=ecghub
HL7_PASSWORD=replace-with-hl7-password

# --- Webhook (when webhook.enabled: true) ---
WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# --- FTP passive mode public IP (Docker + LAN devices) ---
# Set to the Docker host's LAN IP so remote devices can reach the PASV data port.
# Leave empty for bare-metal deployments (auto-detect).
FTP_PUBLIC_HOST=

# -- Polaris credentials ---
POLARIS_FTP_USERNAME=CEX
POLARIS_FTP_PASSWORD=CEX
