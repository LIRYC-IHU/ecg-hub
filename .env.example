# ECG Hub — environment variables.
# Copy to .env and fill in. NEVER commit .env.
#
# Most runtime config (auth providers, FTP/DICOM/HL7 modules, connectors,
# webhooks) is managed from the admin UI and stored encrypted in the DB — NOT
# here. This file holds only bootstrap infra + secrets the server reads on start.

# ─── Core (required) ─────────────────────────────────────────────────────────

# PostgreSQL connection string, as reachable from the backend.
#   bridge / external DB:  host.docker.internal (Docker Desktop) or the DB host
#   host networking (prod, Linux): use 127.0.0.1
DATABASE_URL=postgres://ecghub_user:admin@127.0.0.1:5432/ecghub?sslmode=disable

# HMAC signing secret for JWTs — signs every session token. Long & random.
# Fail-secure: in production (see APP_ENV) the server refuses to start if this is
# the example placeholder or shorter than 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# AES-256-GCM key encrypting all secrets stored in the DB (OIDC/LDAP, FTP/HL7/
# connector credentials). REQUIRED in production: min 32 chars, unique.
# Generate: openssl rand -base64 48
# Fail-secure: production is the DEFAULT. The server refuses to start when this
# key is empty, too short (<32 chars), or the public dev default — UNLESS APP_ENV
# is a development value (development/dev/test/local). See APP_ENV below.
AUTH_ENCRYPTION_KEY=replace-with-a-32+-char-random-key

# Controls fail-fast security checks (strong AUTH_ENCRYPTION_KEY + JWT_SECRET).
# Fail-secure: ONLY development/dev/test/local disable them — any other value,
# OR leaving this unset, is treated as production. Keep this line for local dev.
APP_ENV=development

# ─── Core (optional) ─────────────────────────────────────────────────────────

# Public origin used for CORS and webhook callback URLs (e.g. ecg.chu.fr).
# Defaults to localhost when unset.
HOST_URL=

# Set to "debug" for verbose logging. Default: info.
LOG_LEVEL=info

# Path to config.yaml. Defaults to ./config.yaml.
CONFIG_PATH=

# ─── Metrics (optional) ──────────────────────────────────────────────────────
# Both override the `metrics:` section of config.yaml when set, so a container
# can turn the Prometheus endpoint on or move it without templating the mounted
# file. Unset = whatever config.yaml says (enabled on :9091 by default).
# A malformed value is ignored with a warning — metrics never block startup.
METRICS_ENABLED=
METRICS_PORT=
# Bind addresses. Empty = every interface, which is right on a bridge network
# where the compose file decides what is published. Under network_mode: host
# there is no such boundary: leave these at 127.0.0.1 so the API stays behind
# nginx and the unauthenticated metrics endpoint stays off the site network.
# docker-compose.host.yml sets both.
SERVER_HOST=
METRICS_HOST=

# ─── Ingestion (optional) ────────────────────────────────────────────────────
# Ceiling on a single incoming ECG, as a quantity ("1Mi", "10Mi"). Overrides the
# `ingest.max_file_bytes` key of config.yaml. Every stage of the pipeline holds
# the file in memory, and the FTP/DICOM ports are reachable by devices, so a
# file with no ceiling is a way to push the backend into the OOM killer.
# Unset = 1Mi, about 4x the largest real ECG seen on this project. Anything over
# the cap is refused at the boundary and lands in quarantine with its reason.
# "0" removes the limit entirely.
INGEST_MAX_FILE_BYTES=

# ─── Device whitelist (optional) ─────────────────────────────────────────────
# Directory holding the host's /proc/net files, for the MAC-address device
# whitelist. A container on a bridge network has its own network namespace, so
# its /proc/net/arp lists the other containers and never the devices on the
# site network — the whitelist then identifies nothing and, failing open, lets
# every device through. Mounting the host's tables read-only fixes it without
# host networking and without a capability:
#
#   services:
#     backend:
#       volumes:
#         - /proc/net/arp:/host/proc/net/arp:ro
#         - /proc/net/route:/host/proc/net/route:ro
#
# Linux only: on Docker Desktop these are the VM's tables, not the machine's.
# Unset = read the container's own /proc/net (the whitelist then only sees
# devices that are containers on the same network).
HOST_PROC_NET=

# ─── Webhooks (optional) ─────────────────────────────────────────────────────
# How long a webhook delivery stays in the history, in days. Every delivery
# stores its full payload — patient identifiers included — so the table grows
# with ingested ECGs × enabled webhooks. Unset = 30 days. 0 disables pruning
# and keeps every delivery forever.
WEBHOOKS_RETENTION_DAYS=

# ─── Compose-only (NOT read by the app) ──────────────────────────────────────
# Used only by docker-compose, not by the Go server.

# Bundled Postgres service (`db` in docker-compose.yml). Comment that service
# out when the site provides its own database, and point DATABASE_URL at it —
# these four are then unused.
DB_USER=ecghub_user
DB_PASSWORD=admin
DB_NAME=ecghub
DB_PORT=5432

# Published ports, used only on a non-Linux host where the `ports:` block in
# docker-compose.yml is uncommented (host networking is Linux-only).
FTP_PORT=2121
DICOM_PORT=4242
