# ECG Hub — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to version control.

# --- PostgreSQL ---
DB_USER=ecghub_user
DB_PASSWORD=admin
DATABASE_URL=postgres://ecghub_user:admin@ecghub:5432/ecghub?sslmode=disable

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret

# --- OIDC (when auth.provider: oidc) ---
OIDC_CLIENT_ID=ecg-hub
OIDC_CLIENT_SECRET=replace-with-oidc-secret
# OIDC_ADMIN_CLIENT_SECRET — client secret for the Keycloak Admin API (client_credentials grant).
# Required only if user/role management via the admin endpoints is used. Leave empty to disable.
OIDC_ADMIN_CLIENT_SECRET=

# --- LDAP (when auth.provider: ldap) ---
LDAP_BIND_DN=cn=ecghub,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-with-ldap-password

# --- FTP server credentials ---
FTP_USERNAME=ecgdevice
FTP_PASSWORD=replace-with-ftp-password

# --- HL7 client credentials ---
HL7_USERNAME=ecghub
HL7_PASSWORD=replace-with-hl7-password

# --- Webhook (when webhook.enabled: true) ---
WEBHOOK_SECRET=replace-with-webhook-hmac-secret
